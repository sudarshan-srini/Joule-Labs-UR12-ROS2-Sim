<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur">

    <!-- 1. Accept Launch File Arguments -->
    <xacro:arg name="name" default="ur"/>
    <xacro:arg name="ur_type" default="ur12e"/>

    <!-- Include standard UR macros -->
    <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
    <xacro:include filename="$(find ur_simulation_gz)/urdf/ur_gz.ros2_control.xacro"/>
    <xacro:arg name="simulation_controllers" default=""/>

    <!-- Define Materials -->
    <material name="sky_blue">
        <color rgba="0.35 0.81 0.92 1.0"/>
    </material>
    <material name="rig_green">
        <color rgba="0.45 0.8 0.15 1.0"/>
    </material>

    <!-- 1. The Global Origin -->
    <link name="world"/>

    <!-- 2. The Custom Green Frame (Base of the physical rig) -->
    <link name="base_frame">
        <visual>
            <geometry>
                <mesh filename="package://jl_custom_desc/meshes/NVD01A-10-00_frame.STL" scale=".001 .001 .001"/>
            </geometry>
            <material name="rig_green"/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://jl_custom_desc/meshes/NVD01A-10-00_frame.STL" scale=".001 .001 .001"/>
            </geometry>
        </collision>
        <inertial> 
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="500.0"/> 
            <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
        </inertial>
    </link>

    <!-- Attach the frame to the world with rotation to stand it up -->
    <joint name="world_to_frame" type="fixed">
        <parent link="world"/>
        <child link="base_frame"/>
        <!-- Rotate 90 degrees around X to stand upright -->
        <origin xyz="0 0 0" rpy="1.5708 0 0"/> 
    </joint> 

    <link name="robot_mount_point"/>

    <joint name="frame_to_mount" type="fixed">
        <parent link="base_frame"/>
        <child link="robot_mount_point"/>
        <origin xyz="0 0.45 0.25" rpy="0 0 0"/>
    </joint>


    <!-- 3. The UR12e Robot Arm (Spawned ON TOP of the frame) -->
    <xacro:ur_robot
        name="ur12e"
        tf_prefix=""
        parent="robot_mount_point"
        joint_limits_parameters_file="$(find ur_description)/config/ur12e/joint_limits.yaml"
        kinematics_parameters_file="$(find ur_description)/config/ur12e/default_kinematics.yaml"
        physical_parameters_file="$(find ur_description)/config/ur12e/physical_parameters.yaml"
        visual_parameters_file="$(find ur_description)/config/ur12e/visual_parameters.yaml">

        <!-- Adjust these values until the robot base sits flush on the mounting plate -->
        <origin xyz="0.70 1.125 1.05" rpy="-1.5708 0 0"/>
    </xacro:ur_robot>

    <xacro:ur_ros2_control
        name="ur12e"
        tf_prefix=""
        initial_positions="${dict(shoulder_pan_joint=0.0, shoulder_lift_joint=-1.57, elbow_joint=0.0, wrist_1_joint=-1.57, wrist_2_joint=0.0, wrist_3_joint=0.0)}"/>

    <!-- 3c. Initialize the Gazebo ROS 2 Control Plugin -->
    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(arg simulation_controllers)</parameters>
        </plugin>
    </gazebo>

    <!-- 4. Actuator Body -->
    <link name="actuator_body_link">
        <visual>
            <geometry>
                <mesh filename="package://jl_custom_desc/meshes/ACTUATOR_BODY_for_print.STL" scale=".001 .001 .001"/>
            </geometry>
            <material name="sky_blue"/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://jl_custom_desc/meshes/ACTUATOR_BODY_for_print.STL" scale=".001 .001 .001"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.1"/> 
            <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
        </inertial>
    </link>

    <joint name="tool0_to_actuator_body" type="fixed">
        <parent link="tool0"/> 
        <child link="actuator_body_link"/>
        <origin xyz="0.05 -0.06 -0.02" rpy="1.5708 0 3.14159"/> 
    </joint>

    <!-- 5. Actuator Lid -->
    <link name="actuator_lid_link">
        <visual>
            <geometry>
                <mesh filename="package://jl_custom_desc/meshes/ACTUATOR_LID_for_print.STL" scale=".001 .001 .001"/>
            </geometry>
            <material name="sky_blue"/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://jl_custom_desc/meshes/ACTUATOR_LID_for_print.STL" scale=".001 .001 .001"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.1"/> 
            <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
        </inertial>
    </link>

    <joint name="body_to_lid" type="fixed">
        <parent link="actuator_body_link"/>
        <child link="actuator_lid_link"/>
        <origin xyz="0 0 0.07" rpy="0 0 0"/> 
    </joint>

    <!-- 6. CCS Mount Side 1 -->
    <link name='two_piece_effector_one_side'>
        <visual>
            <geometry>
                <mesh filename="package://jl_custom_desc/meshes/CCS_mount_side_1.STL" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="sky_blue"/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://jl_custom_desc/meshes/CCS_mount_side_1.STL" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.1"/>
            <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
        </inertial>
    </link>

    <joint name="lid_to_effector" type="fixed">
        <parent link="actuator_lid_link"/>
        <child link="two_piece_effector_one_side"/>
        <origin xyz="0.05 0.155 0.209" rpy="0 0 0"/> 
    </joint>    

    <!-- 7. CCS Mount Side 2 -->
    <link name='two_piece_effector_other_side'>
        <visual>
            <geometry>
                <mesh filename="package://jl_custom_desc/meshes/CCS_mount_side_2.STL" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="sky_blue"/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://jl_custom_desc/meshes/CCS_mount_side_2.STL" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.1"/>
            <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
        </inertial>
    </link>

    <joint name="effector_to_effector" type="fixed">
        <parent link="two_piece_effector_one_side"/>
        <child link="two_piece_effector_other_side"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

</robot>